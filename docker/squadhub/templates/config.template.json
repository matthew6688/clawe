{
  "env": {
    "CONVEX_URL": "${CONVEX_URL}",
    "SEEDANCE_API_KEY": "${SEEDANCE_API_KEY}",
    "SEEDANCE_MODEL": "${SEEDANCE_MODEL}",
    "SEEDANCE_BASE_URL": "${SEEDANCE_BASE_URL}"
  },
  "auth": {
    "profiles": {
      "anthropic:default": {
        "provider": "anthropic",
        "mode": "token"
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/data/workspace",
      "compaction": {
        "mode": "safeguard"
      },
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 8
      }
    },
    "list": [
      {
        "id": "main",
        "default": true,
        "name": "Clawe",
        "workspace": "/data/workspace",
        "model": "openai/gpt-4o-mini",
        "identity": {
          "name": "Clawe",
          "emoji": "🦞"
        }
      },
      {
        "id": "inky",
        "name": "Inky",
        "workspace": "/data/workspace-inky",
        "model": "openai/gpt-4o-mini",
        "identity": {
          "name": "Inky",
          "emoji": "✍️"
        }
      },
      {
        "id": "pixel",
        "name": "Pixel",
        "workspace": "/data/workspace-pixel",
        "model": "openai/gpt-4o-mini",
        "identity": {
          "name": "Pixel",
          "emoji": "🎨"
        }
      },
      {
        "id": "scout",
        "name": "Scout",
        "workspace": "/data/workspace-scout",
        "model": "openai/gpt-4o-mini",
        "identity": {
          "name": "Scout",
          "emoji": "🔍"
        }
      }
    ]
  },
  "plugins": {
    "load": {
      "paths": ["/opt/clawe/extensions/clawe"]
    }
  },
  "tools": {
    "sessions": {
      "visibility": "all"
    },
    "agentToAgent": {
      "enabled": true,
      "allow": [
        "main",
        "inky",
        "pixel",
        "scout"
      ]
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto"
  },
  "hooks": {
    "internal": {
      "enabled": true,
      "entries": {
        "session-memory": {
          "enabled": true
        }
      }
    }
  },
  "gateway": {
    "port": ${OPENCLAW_PORT},
    "mode": "local",
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_TOKEN}"
    },
    "tools": {
      "allow": [
        "gateway",
        "sessions_list",
        "sessions_send",
        "message",
        "cron",
        "clawe_pairing"
      ]
    },
    "http": {
      "endpoints": {
        "chatCompletions": {
          "enabled": true
        }
      }
    }
  }
}
